# Chat Service 환경변수 예시
# 사용법: cp .env.example .env 후 값을 설정하세요. (.env 는 Git에 포함되지 않습니다)

# local 프로필 필수
SPRING_MONGODB_URI=mongodb://admin:your-password-here@localhost:27017,localhost:27018,localhost:27019/chatting_db?authSource=admin&replicaSet=rs0

# dev / prod 프로필 필수
# EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://discovery:8761/eureka
